---
// The kothar symbol. Tiles take the text colour (ink on paper, paper on ink); the disc is
// always the brand orange. Never recolour the disc or rearrange the four parts.
interface Props {
  size?: number;
  class?: string;
  label?: string;
}
const { size = 28, class: cls, label } = Astro.props;
---

<svg
  viewBox="0 0 256 256"
  width={size}
  height={size}
  class:list={['mark', cls]}
  {...label ? { role: 'img', 'aria-label': label } : { 'aria-hidden': 'true' }}
>
  <path
    fill="currentColor"
    d="M24 24H96V96H24ZM122 24H166A14 14 0 0 1 180 38V82A14 14 0 0 1 166 96H122A14 14 0 0 1 108 82V38A14 14 0 0 1 122 24ZM52 108H68A28 28 0 0 1 96 136V152A28 28 0 0 1 68 180H52A28 28 0 0 1 24 152V136A28 28 0 0 1 52 108Z"
  ></path>
  <circle class="mark-disc" cx="170.5" cy="170.5" r="62.5" fill="#F04E15"></circle>
</svg>
