{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kothar-site",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  "routes": [{ "pattern": "kothar.ilien.dev", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false
}
